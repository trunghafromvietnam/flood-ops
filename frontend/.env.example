# Copy to .env.local to override. Everything here is public: it is compiled into the browser bundle.
# Never put secrets in VITE_* variables.

# Backend origin. Empty = same origin (Vite proxies /api to http://127.0.0.1:8000 in development).
VITE_API_BASE_URL=

# Vector base-map style. Default: OpenFreeMap "liberty".
VITE_MAP_STYLE_URL=

# Place search endpoint (Nominatim-compatible). Default: nominatim.openstreetmap.org.
VITE_GEOCODER_URL=
